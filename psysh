["function","Get len bytes data from open blob\n\nThis function returns at most <parameter>len<\/parameter> bytes from a BLOB that has been opened for reading by <function>ibase_blob_open<\/function>.\n\nIt is not possible to read from a BLOB that has been opened for writing by <function>ibase_blob_create<\/function>.",[["$blob_handle","resource","A BLOB handle opened with <function>ibase_blob_open<\/function>."],["$len","int","Size of returned data."]],["string","Returns at most <parameter>len<\/parameter> bytes from the BLOB, or <type>false<\/type> on failure."],["<function>ibase_blob_open<\/function>","<function>ibase_blob_close<\/function>","<function>ibase_blob_echo<\/function>"]]
["function","Create blob, copy file in it, and close it\n\nThis function creates a BLOB, reads an entire file into it, closes it and returns the assigned BLOB id.",[["$link_identifier","resource","An InterBase link identifier. If omitted, the last opened link is assumed."],["$file_handle","resource","The file handle is a handle returned by <function>fopen<\/function>."]],["string","Returns the BLOB id on success, or <type>false<\/type> on error."],["<function>ibase_blob_add<\/function>","<function>ibase_blob_cancel<\/function>","<function>ibase_blob_close<\/function>","<function>ibase_blob_create<\/function>"]]
