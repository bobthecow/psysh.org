["function","Gets geometry of a string\n\nThis function is similar to <function>ps_stringwidth<\/function> but returns an array of dimensions containing the width, ascender, and descender of the text.",[["$psdoc","resource","Resource identifier of the postscript file as returned by <function>ps_new<\/function>."],["$text","string","The text for which the geometry is to be calculated."],["$fontid","int","The identifier of the font to be used. If not font is specified the current font will be used."],["$size","float","The size of the font. If no size is specified the current size is used."]],["array","An array of the dimensions of a string. The element 'width' contains the width of the string as returned by <function>ps_stringwidth<\/function>. The element 'descender' contains the maximum descender and 'ascender' the maximum ascender of the string."],["<function>ps_continue_text<\/function>","<function>ps_stringwidth<\/function>"]]
["function","Gets width of a string\n\nCalculates the width of a string in points if it was output in the given font and font size. This function needs an Adobe font metrics file to calculate the precise width. If kerning is turned on, it will be taken into account.",[["$psdoc","resource","Resource identifier of the postscript file as returned by <function>ps_new<\/function>."],["$text","string","The text for which the width is to be calculated."],["$fontid","int","The identifier of the font to be used. If not font is specified the current font will be used."],["$size","float","The size of the font. If no size is specified the current size is used."]],["float","Width of a string in points."],["<function>ps_string_geometry<\/function>"]]
