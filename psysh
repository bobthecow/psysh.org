["function","Get the three letter country code\n\nThe <function>geoip_country_code3_by_name<\/function> function will return the three letter country code corresponding to a hostname or an IP address.",[["$hostname","string","The hostname or IP address whose location is to be looked-up."]],["string","Returns the three letter country code on success, or <type>false<\/type> if the address cannot be found in the database."],["<function>geoip_country_code_by_name<\/function>","<function>geoip_country_name_by_name<\/function>"]]
["function","Get the two letter country code\n\nThe <function>geoip_country_code_by_name<\/function> function will return the two letter country code corresponding to a hostname or an IP address.",[["$hostname","string","The hostname or IP address whose location is to be looked-up."]],["string","Returns the two letter ISO country code on success, or <type>false<\/type> if the address cannot be found in the database."],["<function>geoip_country_code3_by_name<\/function>","<function>geoip_country_name_by_name<\/function>"]]
