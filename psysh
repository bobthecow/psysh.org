["function","Quote meta characters\n\nReturns a version of str with a backslash character (<literal>\\<\/literal>) before every character that is among these:  . \\ + * ? [ ^ ] ( $ )",[["$string","string","The input string."]],["string","Returns the string with meta characters quoted, or <type>false<\/type> if an empty string is given as <parameter>string<\/parameter>."],["<function>addslashes<\/function>","<function>addcslashes<\/function>","<function>htmlentities<\/function>","<function>htmlspecialchars<\/function>","<function>nl2br<\/function>","<function>stripslashes<\/function>","<function>stripcslashes<\/function>","<function>preg_quote<\/function>"]]
